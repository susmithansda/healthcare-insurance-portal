PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Empty URI uses the persistent, synthetic-data JSON demonstration database.
MONGODB_URI=
# Required in production: use a randomly generated secret of at least 32 characters.
JWT_SECRET=
# Set true to create synthetic demonstration users (never enable for real patient data).
SEED_DEMO=true
# Sandbox checkout is enabled by default ONLY outside production.
ALLOW_DEMO_PAYMENTS=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional raw webhook signature secret; enables /api/payments/webhook.
RAZORPAY_WEBHOOK_SECRET=

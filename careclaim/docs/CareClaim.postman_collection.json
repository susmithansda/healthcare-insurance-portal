        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me",
            "description": ""
          }
        },
        {
          "name": "Update contact details",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aarav Sharma\",\n  \"phone\": \"9876543210\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/profile",
            "description": "Updates the authenticated user's own profile."
          }
        }
      ]
    },
    {
      "name": "Claims and documents",
      "item": [
        {
          "name": "List authorized claims",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/claims",
            "description": ""
          }
        },
        {
          "name": "Filter pending claims",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/claims?status=Pending&search=",
            "description": ""
          }
        },
        {
          "name": "Dashboard statistics",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/claims/stats",
            "description": ""
          }
        },
        {
          "name": "Get a claim",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/claims/{{claimId}}",
            "description": ""
          }
        },
        {
          "name": "Submit a sample claim (patient/hospital/admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policyNumber\": \"CC-2026-104201\",\n  \"age\": 32,\n  \"gender\": \"Male\",\n  \"claimAmount\": 18000,\n  \"disease\": \"Diagnostic evaluation\",\n  \"hospital\": \"Sample Care Hospital\",\n  \"admissionDate\": \"2026-11-08\",\n  \"dischargeDate\": \"2026-11-09\",\n  \"previousClaimHistory\": \"Synthetic test submission\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/claims",
            "description": "Uses the server seed's first policy. Dates must be within the assigned active policy and not in the future. Saves the created internal claim ID for subsequent requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful API response', function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
                  "if (pm.response.code < 300) { const value = pm.response.json().claim.id; if (value) pm.collectionVariables.set('claimId', value); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Edit a pending claim (owner/hospital submitter/admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"disease\": \"Diagnostic evaluation\",\n  \"hospital\": \"Sample Care Hospital\",\n  \"claimAmount\": 17500\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/claims/{{claimId}}",
            "description": "Only a Pending claim can be edited; policy identity cannot change."
          }
        },
        {
          "name": "Approve a pending claim (officer/admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Approved\",\n  \"remarks\": \"Sample supporting documents have been reviewed and verified.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/claims/{{claimId}}",
            "description": "Mutates the claim and coverage usage. Final decisions are immutable. Run the officer/admin login first."
          }
        },
        {
          "name": "Upload a document (authorized submitter/admin)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "documents",
                  "type": "file",
                  "src": [],
                  "description": "Choose PDF, PNG or JPEG files in Postman before sending."
                }
              ]
            },
            "url": "{{baseUrl}}/claims/{{claimId}}/documents",
            "description": "Choose up to five files, 5 MB each, on a Pending claim. File content signatures are checked. The returned claim contains document IDs."
          }
        },
        {
          "name": "Download a protected document",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/documents/{{documentId}}",
            "description": "Set documentId from an upload response. Requires permission to view the associated claim."
          }
        }
      ]
    },
    {
      "name": "Policies",
      "item": [
        {
          "name": "List authorized policies",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/policies",
            "description": "Patients see their own policies; staff see all. New policies are assigned by the operator provisioning CLI."
          }
        }
      ]
    },
    {
      "name": "Premium payments",
      "item": [
        {
          "name": "List authorized payment receipts",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/payments",
            "description": ""
          }
        },
        {
          "name": "Create checkout order (patient only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policyId\": \"{{policyId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/payments/order",
            "description": "The API uses the stored premium, not an amount supplied by this request. Captures internal orderId. Inspect provider: demo is a simulation; razorpay requires browser-hosted gateway checkout."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful API response', function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
                  "if (pm.response.code < 300) { const value = pm.response.json().order.id; if (value) pm.collectionVariables.set('orderId', value); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm sandbox payment (demo provider only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/payments/verify",
            "description": "Use only after a demo-provider order. This records a sample premium receipt without moving money. Real Razorpay confirmation additionally needs razorpay_payment_id and razorpay_signature from hosted checkout. Repeating confirmation returns the original receipt."
          }
        }
      ]
    },
    {
      "name": "Audit",
      "item": [
        {
          "name": "Review audit history (officer/admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/audit",
            "description": "Records submissions, reviews, payments, profile updates and operator actions."
          }
        }
      ]
    }
  ]
}

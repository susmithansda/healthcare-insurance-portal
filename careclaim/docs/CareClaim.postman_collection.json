{
  "info": {
    "name": "CareClaim — Medical Mediclaim REST API",
    "description": "API explorer for the local CareClaim project. Start the Express server first. Import this file into Postman, select a demo role login, then run the desired protected requests individually. Demo logins require synthetic seeding. This is not an unattended collection-runner sequence: review and checkout requests mutate sample records, and role requirements differ. Never put real credentials or captured tokens into the committed JSON. The static hosted preview has no Express API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "claimId",
      "value": "claim-3",
      "type": "string"
    },
    {
      "key": "policyId",
      "value": "policy-1",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "documentId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "API health and runtime mode",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/health",
            "description": "Reports demo/mongodb storage mode and demo/razorpay/disabled payment provider."
          }
        }
      ]
    },
    {
      "name": "Authentication and profile",
      "item": [
        {
          "name": "Login — patient (synthetic demo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient@careclaim.demo\",\n  \"password\": \"Demo@12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Run the intended role's login before exploring protected requests. Saves only the returned token to this collection's local token variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful API response', function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
                  "if (pm.response.code < 300) { const value = pm.response.json().token; if (value) pm.collectionVariables.set('token', value); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login — hospital (synthetic demo)",
          "request": {
            "method": "POST",
            "header": [

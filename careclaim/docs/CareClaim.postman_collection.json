        {
          "name": "Register a synthetic patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Student\",\n  \"email\": \"student-demo@example.test\",\n  \"password\": \"DemoStudent123\",\n  \"phone\": \"9876543200\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Example demonstration account only. Change the email to avoid a duplicate. Public registration cannot create staff; this user needs an operator-assigned policy before submitting a claim."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful API response', function () { pm.expect(pm.response.code).to.be.within(200, 299); });",

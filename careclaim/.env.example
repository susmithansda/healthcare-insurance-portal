# This root file is used by Docker Compose. For npm development use server/.env.
# Generate a secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:4000
# Keep gateway credentials in .env (Docker) or server/.env (npm), never in this example.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# HTTPS email delivery endpoint accepting {email, resetUrl, expiresInMinutes}.
RESET_EMAIL_WEBHOOK_URL=
RESET_EMAIL_WEBHOOK_SECRET=
